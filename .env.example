# Atlas Visual — environment variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Figma personal access token
# Generate at: https://www.figma.com/settings → Personal access tokens
FIGMA_TOKEN=your-figma-personal-access-token

# Figma file key (from the file URL: figma.com/design/<FILE_KEY>/...)
FIGMA_FILE_KEY=your-figma-file-key

# Figma node ID (right-click a frame in Figma → Copy link → extract node-id param)
FIGMA_NODE_ID=your-figma-node-id

# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations. Atlas runs fully without any of these — they are only
# read when the matching action is explicitly enabled in atlas.config.yaml.
# The Qase action shipped in v1.0 is a mock and does not require a real token.
# ─────────────────────────────────────────────────────────────────────────────

# Qase API token (only if you enable actions.qase and wire a real QaseClient)
# QASE_TOKEN=your-qase-api-token
